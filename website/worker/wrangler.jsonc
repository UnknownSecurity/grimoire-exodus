{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "grimoire-exodus-issue-relay",
  "main": "src/index.mjs",
  "compatibility_date": "2026-10-18",
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "ALLOWED_ORIGINS": "https://unknownsecurity.github.io,http://localhost:3000,http://127.0.0.1:3000",
    "GITHUB_OWNER": "UnknownSecurity",
    "GITHUB_REPO": "grimoire-exodus"
  },
  "ratelimits": [
    {
      "name": "ISSUE_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 3,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
